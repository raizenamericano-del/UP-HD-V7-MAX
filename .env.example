# ============================================================================
# JernihHD v7 — Environment Variables (by Rifky)
# Copy jadi .env lalu isi sesuai kebutuhan. Di Railway: isi di tab Variables.
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=production
# Direktori data persistent (session Baileys, uploads, riwayat, video hasil)
# ⚠ Railway filesystem-nya EPHEMERAL: pasang Volume (mount path /data) lalu
#   set DATA_DIR=/data — kalau tidak, session WA hilang tiap redeploy.
#   (kalau volume di-mount, RAILWAY_VOLUME_MOUNT_PATH otomatis dipakai)
DATA_DIR=./data
# Proteksi akses web (opsional). Kalau diisi, app minta "App Key" dulu.
APP_KEY=

# ---- Batas ukuran ----
MAX_UPLOAD_MB=500   # batas upload video (default v5.0.3: 500 MB)
# Batas ukuran output non-WA (TikTok/IG/Shorts/Universal). WA message aman ±64MB.
MAX_OUTPUT_MB=50
# Budget khusus TikTok/IG/Shorts (file DIUNDUH lalu diunggah manual, bukan
# dikirim lewat WA). Budget kecil = bitrate dipangkas = hasil pecah.
MAX_SOCIAL_MB=150
# Cara meletakkan video di kanvas platform (v6 anti-pecah):
#   smart = otomatis (crop penuh kalau AR cocok, kalau tidak muat utuh + latar buram)
#   fill  = crop penuh, penuhi layar
#   pad   = muat utuh, sisi kosong diisi latar buram
#   none  = ukuran asli (perilaku v5, tidak pernah upscale)
SOCIAL_FIT=smart
# Budget output khusus target WA Status + info limit di UI
STATUS_MAX_MB=16
STATUS_MAX_SEC=30

# ---- Mesin video (JernihHD Engine v7) ----
# Kosongkan kalau mau pakai ffmpeg-static bawaan npm (dev lokal).
# Di Docker image ffmpeg sistem dipakai otomatis: /usr/bin/ffmpeg
FFMPEG_PATH=
FFPROBE_PATH=
# Preset x264 per mode encode
#   turbo    = veryfast (paling cepat)
#   balanced = medium   (default, kualitas tinggi)
#   max      = slow     (2-pass, paling rapi)
FFMPEG_PRESET_FAST=veryfast
FFMPEG_PRESET=medium
FFMPEG_PRESET_SLOW=slow
# Thread ffmpeg (kosongkan = otomatis, maks 12)
FFMPEG_THREADS=
# Normalisasi loudness EBU R128 (target LUFS/TP mengikuti platform)
AUDIO_NORMALIZE=true
# Bitrate audio AAC (spec v5: 192 kbps @ 48 kHz)
AUDIO_BITRATE_KBPS=192
# Mode encode default: turbo | balanced | max
ENGINE_MODE=balanced
# Target platform default: wa | tiktok | ig | shorts | universal
DEFAULT_TARGET=wa
# Auto-trim sesuai limit platform (WA 30s / IG 90s / Shorts 180s)
AUTO_TRIM=true

# ---- WhatsApp / Baileys ----
# Nama perangkat yang muncul di "Perangkat Tertaut"
WA_BROWSER=ubuntu
WA_BROWSER_NAME=Chrome (Linux)
# Masa berlaku pairing code (WhatsApp ±2 menit)
PAIRING_TTL_MS=120000
QR_TIMEOUT_MS=60000
CONNECT_TIMEOUT_MS=60000
KEEP_ALIVE_MS=25000
RECONNECT_MAX_DELAY_MS=30000

# ---- Penyimpanan riwayat ----
KEEP_VIDEOS=12
MAX_HISTORY=40

# ---- Mode uji (JANGAN aktifkan di produksi) ----
MOCK_SEND=false

# ---------------------------------------------------------------------------
# Resource / RAM
# ---------------------------------------------------------------------------
# Video besar (2K/4K, 120fps, HEVC) butuh RAM lumayan saat di-encode.
# Engine otomatis deteksi limit RAM container:
#   LOW_MEM=auto  → hemat kalau RAM container ≤ 1200 MB (default)
#   LOW_MEM=on    → paksa mode hemat (lookahead 20, 2 thread)
#   LOW_MEM=off   → paksa kualitas maksimal (butuh RAM ≥ 1.5 GB)
LOW_MEM=auto

# Jumlah thread ffmpeg. Makin banyak = makin cepat TAPI makin boros RAM.
# Container kecil (0.5–1 GB): pakai 1 atau 2.
FFMPEG_THREADS=2
